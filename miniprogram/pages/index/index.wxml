<view class="menu">
  <view class="hero">
    <view class="title">中国象棋</view>
    <view class="subtitle">人机对战 · 本地双人 · 好友联机</view>
  </view>

  <view class="group">
    <view class="label">AI 难度</view>
    <view class="seg">
      <view
        wx:for="{{levels}}"
        wx:key="key"
        class="seg-item {{difficulty === item.key ? 'on' : ''}}"
        data-key="{{item.key}}"
        bindtap="onPickLevel"
      >{{item.label}}</view>
    </view>
  </view>

  <button class="btn primary" bindtap="onStartAI">人机对战</button>
  <button class="btn primary" bindtap="onStartLocal">本地双人</button>
  <button class="btn primary" bindtap="onStartOnline">好友联机</button>
  <button class="btn ghost" bindtap="onRules">查看规则</button>

  <view class="foot">人机与本地双人纯本地运行 · 联机需开通云开发</view>
</view>
