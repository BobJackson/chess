.lobby {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 72rpx 56rpx 48rpx;
  display: flex;
  flex-direction: column;
}

.hero {
  text-align: center;
  margin-bottom: 64rpx;
}

.title {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: #4e342e;
}

.subtitle {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #8d6e63;
}

.card {
  background: #fffaf0;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(93, 64, 55, 0.10);
}

.input {
  background: #f3e9d2;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 32rpx;
  letter-spacing: 8rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.btn.primary {
  width: 100%;
  background: #5d4037;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  line-height: 88rpx;
  height: 88rpx;
}

.code {
  margin-top: 24rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 12rpx;
  color: #b3261e;
}

.divider {
  text-align: center;
  color: #a1887f;
  font-size: 24rpx;
  margin: 32rpx 0;
}

.status {
  margin-top: 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: #6d4c41;
}
